# Copy this file to .env and fill in the values.

# Matches docker-compose.yml in the project root (port 5433 on your Mac).
DATABASE_URL="postgresql://meal:meal@localhost:5433/mealplanner"

# Any long random string. Generate one with:
#   openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Where the frontend runs (for CORS).
CLIENT_ORIGIN="http://localhost:5173"

PORT=4000

# ── Email (optional) ─────────────────────────────────────────
# Leave these empty while developing: verification codes are then
# printed in the server terminal instead of being emailed.
#
# To send real emails with Gmail:
#   1. Turn on 2-Step Verification for your Google account.
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Fill in:
#        SMTP_HOST="smtp.gmail.com"
#        SMTP_PORT=465
#        SMTP_USER="you@gmail.com"
#        SMTP_PASS="the 16-letter app password"
#        EMAIL_FROM="Dorm Kitchen <you@gmail.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
